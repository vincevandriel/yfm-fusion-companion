<UserControl x:Class="YfmCompanion.Desktop.Controls.CardTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,5">
        <StackPanel>
            <TextBlock Text="{Binding TileCaption}" FontSize="10" Foreground="{StaticResource GoldBrush}" />
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,3" />
            <TextBlock Text="{Binding DetailLine}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
