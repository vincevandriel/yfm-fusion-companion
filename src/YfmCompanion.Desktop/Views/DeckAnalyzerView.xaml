<UserControl x:Class="YfmCompanion.Desktop.Views.DeckAnalyzerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:YfmCompanion.Desktop.Controls">
<Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Header="DECK • up to 40 cards" Margin="0">
                          <StackPanel>
                            <TextBlock x:Name="DeckTraySummary" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel>
                              <StackPanel x:Name="DeckAddPickerPanel" Width="310" Margin="0,0,10,0" />
                              <Button x:Name="AddDeckCardButton" Content="ADD COPY" Click="AddDeckCard_Click" VerticalAlignment="Center" />
                              <Button Content="REMOVE SELECTED COPY" Click="RemoveDeckCard_Click" VerticalAlignment="Center" />
                            </WrapPanel>
                            <ListBox x:Name="DeckTrayGallery" Height="230" ItemTemplate="{StaticResource ReadOnlyCardTile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Width" Value="215" /><Setter Property="BorderThickness" Value="2" /></Style></ListBox.ItemContainerStyle>
                            </ListBox>
                            <Expander Header="ADVANCED • EDIT INDIVIDUAL DECK SLOTS">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="280">
                                <WrapPanel x:Name="DeckPickerPanel" ItemWidth="235" />
                            </ScrollViewer>
                            </Expander>
                          </StackPanel>
                        </GroupBox>
                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <Button x:Name="AnalyzeDeckButton" Content="ANALYZE ALL 5-CARD HANDS" Click="AnalyzeDeck_Click" />
                                <Button x:Name="LoadCurrentDeckButton" Content="LOAD CURRENT DECK FROM SAVE" Click="LoadCurrentDeckFromSave_Click" Background="#245475" />
                                <Button x:Name="CancelDeckButton" Content="CANCEL" Click="CancelDeck_Click" IsEnabled="False" Background="#264C67" />
                                <Button Content="CLEAR" Click="ClearDeck_Click" Background="#263E50" />
                            </WrapPanel>
                            <CheckBox Grid.Row="1" x:Name="DeckIncludeGlitchesCheckBox" Content="Include documented glitch fusions" IsChecked="True" HorizontalAlignment="Right" Margin="0,8,0,0" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="ANY FUSION / EQUIP" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="AnyFusionMetric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="ATK ≥ 2500" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="AtLeast2500Metric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="ATK ≥ 2800" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="AtLeast2800Metric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="ATK ≥ 3000" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="AtLeast3000Metric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="EXPECTED BEST ATK" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="ExpectedAttackMetric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="5" Background="{StaticResource PanelBrush}" Padding="10"><StackPanel><TextBlock Text="DEAD HAND" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DeadHandMetric" Text="—" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                              <TextBlock x:Name="DeckResultSummary" Text="Fill any number of slots. A 40-card deck examines exactly 658,008 physical five-card hands." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                              <ProgressBar x:Name="DeckAnalysisProgressBar" Minimum="0" Maximum="1" Height="8" Margin="0,0,0,8" />
                            </StackPanel>
                            <DataGrid x:Name="DeckResultsGrid" Grid.Row="1" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.RowDetailsTemplate><DataTemplate><TextBlock Text="{Binding Route}" TextWrapping="Wrap" Margin="12" MaxWidth="560" HorizontalAlignment="Left" /></DataTemplate></DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="2*" />
                                    <DataGridTextColumn Header="FINAL ATK" Binding="{Binding Attack}" Width="80" />
                                    <DataGridTextColumn Header="FINAL DEF" Binding="{Binding Defense}" Width="80" />
                                    <DataGridTextColumn Header="HAND CHANCE" Binding="{Binding Probability}" Width="110" />
                                    <DataGridTextColumn Header="HANDS" Binding="{Binding Hands}" Width="110" />
                                    <DataGridTextColumn Header="REPRESENTATIVE ROUTE" Binding="{Binding Route}" Width="4*" />
                                    <DataGridCheckBoxColumn Header="GLITCH" Binding="{Binding IsGlitch}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
</UserControl>
