<UserControl x:Class="YfmCompanion.Desktop.Views.OwnedOptimizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:YfmCompanion.Desktop.Controls">
<Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="OptimizerSourcePane" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="OptimizerSourceTitle" Text="AUTOMATIC — NEWEST SAVE" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OptimizerSourceSummary" Text="Looking for the newest supported Forbidden Memories save…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                    <TextBlock x:Name="SaveSnapshotStatus" Text="Saved snapshot details will appear here." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="RefreshSaveButton" Content="REFRESH" Click="RefreshSaveSnapshot_Click" Padding="10,6" />
                                    <Button Content="CHOOSE SAVE FILE…" Click="SelectSave_Click" Padding="10,6" />
                                    <Button Content="AUTOMATIC NEWEST" Click="UseAutomaticSave_Click" Padding="10,6" />
                                    <Button Content="ENTER CARDS MANUALLY" Click="UseManualCollection_Click" Padding="10,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <GroupBox x:Name="OptimizerStrategyPane" Grid.Row="1" Header="STRATEGY • choose the job this deck must do" Margin="0">
                            <StackPanel>
                              <controls:AdaptiveColumnsPanel MinimumColumnWidth="230" MaximumColumns="3">
                                <StackPanel>
                                    <TextBlock Text="CAMPAIGN GOAL" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="CampaignScopeCombo" DisplayMemberPath="Label" SelectedValuePath="Scope" SelectionChanged="CampaignScope_SelectionChanged" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TARGET DUELIST" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="CampaignOpponentCombo" DisplayMemberPath="Label" SelectedValuePath="DuelistId" Visibility="Collapsed" />
                                    <TextBlock x:Name="CampaignOpponentHint" Text="Choose “One specific opponent” to select a duelist." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox x:Name="UseSavedStarChipsCheckBox" Content="USE SAVED STAR CHIPS" Checked="CampaignStarChipSetting_Changed" Unchecked="CampaignStarChipSetting_Changed" IsEnabled="False" />
                                    <TextBlock x:Name="CampaignInputHint" Text="Load a saved snapshot to use its Star Chip budget; the optimizer otherwise uses only the owned quantities below." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                              </controls:AdaptiveColumnsPanel>
                              <Expander Header="ADVANCED STRATEGY SETTINGS" Margin="0,10,0,0">
                               <StackPanel Margin="0,8,0,0">
                                <controls:AdaptiveColumnsPanel MinimumColumnWidth="230" MaximumColumns="4">
                                 <StackPanel><TextBlock Text="CUSTOM PROFILE" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="OptimizerProfileCombo" DisplayMemberPath="Label" SelectedValuePath="Profile" SelectionChanged="OptimizerProfile_SelectionChanged" /></StackPanel>
                                 <StackPanel><TextBlock Text="FOCUS TYPES • comma separated" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBox x:Name="PreferredTypesTextBox" ToolTip="Examples: Dragon, Thunder or Pyro, Dragon" /></StackPanel>
                                 <StackPanel><TextBlock Text="FIELD" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="PreferredFieldCombo" DisplayMemberPath="Label" SelectedValuePath="CardId" /></StackPanel>
                                 <StackPanel><TextBlock Text="OPPONENT TYPES • comma separated" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBox x:Name="OpponentTypesTextBox" ToolTip="Raises relevant type-removal cards; example: Dragon, Warrior" /></StackPanel>
                                </controls:AdaptiveColumnsPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="CPU WORKERS" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="CpuWorkersCombo" DisplayMemberPath="Label" SelectedValuePath="Count" ToolTip="Auto uses up to four workers for searches and eight for exact analysis. Counts are reduced on smaller CPUs. A manual count applies to both optimizer stages. One worker uses serial search. Proof traversal remains serial." />
                                </StackPanel>
                                <TextBlock x:Name="OptimizerProfileDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,8" />
                                <CheckBox x:Name="OptimizerIncludeGlitchesCheckBox" Content="Include documented glitch fusions" IsChecked="True" />
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="ALREADY REDEEMED PASSWORD CARD NAMES • comma separated" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBox x:Name="AlreadyRedeemedCardsTextBox" ToolTip="Optional. These card names are excluded from virtual Star Chip recommendations because a save does not record past password redemption." />
                                </StackPanel>
                               </StackPanel>
                              </Expander>
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Grid.Row="2" Margin="0,12,0,10">
                          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                              <controls:AdaptiveColumnsPanel MinimumColumnWidth="240" MaximumColumns="2">
                                <StackPanel><TextBlock Text="SEARCH MODE" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ComboBox x:Name="OptimizerSpeedCombo" DisplayMemberPath="Label" SelectedValuePath="Mode" /></StackPanel>
                                <StackPanel><TextBlock x:Name="OptimizationStageText" Text="{Binding Stage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <ProgressBar x:Name="OptimizationProgressBar" Height="10" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding Value}" IsIndeterminate="{Binding IsIndeterminate}" /></StackPanel>
                              </controls:AdaptiveColumnsPanel>
                              <TextBlock x:Name="OptimizationProgressDetail" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                              <Expander Header="ADVANCED PROOF SEARCH" Margin="0,8,0,0">
                               <StackPanel>
                                <CheckBox x:Name="ProveOptimalCheckBox" Margin="0,6,0,0"><TextBlock Text="Prove optimal for this scoring model (may be impractical; checkpointed)" TextWrapping="Wrap" /></CheckBox>
                                <CheckBox x:Name="NewProofCheckpointCheckBox" Margin="0,6,0,0"><TextBlock Text="Start a new proof checkpoint; preserve the old file as a backup" TextWrapping="Wrap" /></CheckBox>
                                <TextBlock Text="Proof searches can resume after restarting the app when the same collection and options are selected. Quick, Balanced and Thorough can resume only while this window remains open." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                               </StackPanel>
                              </Expander>
                            </StackPanel>
                          </Border>
                          <WrapPanel>
                            <Button x:Name="RecommendedDecksButton" Content="RECOMMENDED DECKS" Click="RecommendedDecks_Click" />
                            <Button x:Name="OptimizeDeckButton" Content="BUILD DECK" Click="OptimizeDeck_Click" />
                            <Button x:Name="PauseOptimizationButton" Grid.Column="1" Content="PAUSE" Click="PauseOptimization_Click" IsEnabled="False" />
                            <Button x:Name="StopOptimizationButton" Grid.Column="2" Content="STOP AND KEEP BEST" Click="StopOptimization_Click" IsEnabled="False" />
                            <Button x:Name="VerifyOptimizationButton" Grid.Column="3" Content="VERIFY DECK" Click="VerifyOptimization_Click" IsEnabled="False" />
                            <Button Grid.Column="4" Content="CLEAR OWNED" Click="ClearOwned_Click" IsEnabled="{Binding CanEdit}" />
                          </WrapPanel>
                          <WrapPanel Margin="0,2,0,4">
                            <TextBlock x:Name="RecommendedStrategyText" Text="Starting strategy: automatic • compare all six builds" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <Button Content="RESET STRATEGY" Click="ResetRecommendedStrategy_Click" FontSize="11" Padding="7,3" IsEnabled="{Binding CanEdit}"/>
                          </WrapPanel>
                          <TextBlock x:Name="OptimizationStatus" Text="Owned cards load automatically from the newest save." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid x:Name="OptimizerBody" Grid.Row="3" SizeChanged="OptimizerBody_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OptimizerOwnedRow" Height="*" />
                                <RowDefinition x:Name="OptimizerResultRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OptimizerOwnedColumn" Width="0.8*" />
                            <ColumnDefinition x:Name="OptimizerResultColumn" Width="1.6*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox x:Name="OptimizerOwnedPane" Header="OWNED COLLECTION" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="OwnedSearchBox" TextChanged="OwnedSearch_TextChanged" Margin="0,0,7,8" ToolTip="Search owned cards by name or card number" />
                                        <ComboBox x:Name="OwnedTypeFilterCombo" Grid.Column="1" SelectionChanged="OwnedFilter_Changed" Margin="0,0,7,8" />
                                        <ComboBox x:Name="OwnedSortCombo" Grid.Column="2" SelectionChanged="OwnedFilter_Changed" Margin="0,0,0,8" />
                                    </Grid>
                                    <StackPanel x:Name="OwnedAddPickerPanel" Grid.Row="1" Margin="0,0,0,8" />
                                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                                        <Button Content="ADD CARD" Click="AddOwnedCard_Click" Padding="10,5" IsEnabled="{Binding CanEdit}" />
                                        <Button Content="CUSTOM ART FOLDER…" ToolTip="Optional overrides. All 722 card images are included automatically." Click="ChooseArtworkFolder_Click" Padding="10,5" />
                                        <Button Content="CUSTOM SELECTED ART…" ToolTip="Optional image override for the selected card." Click="AssignSelectedArtwork_Click" Padding="10,5" />
                                        <TextBlock x:Name="OwnedCollectionCount" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                    </WrapPanel>
                                    <ListBox x:Name="OwnedCardsGallery" Grid.Row="3" Height="440" SelectionChanged="OwnedCards_SelectionChanged"
                                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CardTileStyle}" /></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="78">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Border Background="#0A172B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                        <Grid>
                                                            <Image Source="{Binding Artwork}" Stretch="Uniform" />
                                                            <TextBlock Text="{Binding Card.Id}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding Artwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" MinWidth="0">
                                                        <TextBlock Text="{Binding Card.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding QuantityLine}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProposedLine}" Foreground="{StaticResource GoldBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" Width="44" HorizontalAlignment="Right" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DataContext.IsCollectionReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" ToolTip="Total owned copies" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </GroupBox>
                            <Grid x:Name="OptimizerResultPane" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <controls:AdaptiveColumnsPanel Grid.Row="1" Margin="0,0,0,10" MinimumColumnWidth="140" MaximumColumns="4">

                                    <Border Background="{StaticResource PanelBrush}" Padding="9" Margin="0,0,7,0"><StackPanel><TextBlock Text="ATK ≥ 2800" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="Optimizer2800Metric" Text="—" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
                                    <Border Background="{StaticResource PanelBrush}" Padding="9" Margin="0,0,7,0"><StackPanel><TextBlock Text="ATK ≥ 2500" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="Optimizer2500Metric" Text="—" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
                                    <Border Background="{StaticResource PanelBrush}" Padding="9" Margin="0,0,7,0"><StackPanel><TextBlock Text="EXPECTED BEST" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="OptimizerExpectedMetric" Text="—" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
                                    <Border Background="{StaticResource PanelBrush}" Padding="9"><StackPanel><TextBlock Text="DEAD HAND" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="OptimizerDeadMetric" Text="—" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
                                </controls:AdaptiveColumnsPanel>
                                <Border x:Name="CampaignPlanPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="CampaignScopeSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CampaignSafetySummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock x:Name="CampaignPurchaseSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <TabControl Grid.Row="3">
                                    <TabItem Header="DECK">
                                      <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                                            <TextBlock Text="CARD ORDER" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                            <ComboBox x:Name="SuggestedDeckSortCombo" Width="170" SelectionChanged="SuggestedDeckSort_Changed" ToolTip="Alphabetical: A–Z. Card number: lowest first. ATK and DEF: highest first." />
                                        </WrapPanel>
                                        <DataGrid x:Name="OptimizedDeckGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="COPIES" Binding="{Binding Copies}" Width="60" MinWidth="60" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="CARD" Binding="{Binding Card.Name}" Width="180" MinWidth="180" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="NO." Binding="{Binding Card.Id}" Width="48" MinWidth="48" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="OWNED" Binding="{Binding Owned}" Width="70" MinWidth="70" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="BUY" Binding="{Binding Purchase}" Width="48" MinWidth="48" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="TYPE" Binding="{Binding Card.PrimaryType}" Width="95" MinWidth="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="ATK" Binding="{Binding Card.Attack}" Width="60" MinWidth="60" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="DEF" Binding="{Binding Card.Defense}" Width="60" MinWidth="60" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="WHY INCLUDED" Binding="{Binding Reason}" Width="260" MinWidth="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                      </DockPanel>
                                    </TabItem>
                                    <TabItem Header="OUTCOMES">
                                        <DataGrid x:Name="OptimizationTargetsGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="RESULT" Binding="{Binding Result.Name}" Width="180" MinWidth="180" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="FINAL ATK" Binding="{Binding EffectiveAttack}" Width="75" MinWidth="75" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="CHANCE" Binding="{Binding FormattedProbability}" Width="90" MinWidth="90" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="REPRESENTATIVE ROUTE" Binding="{Binding Route}" Width="260" MinWidth="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="LIMITS">
                                        <DataGrid x:Name="LimitedCardsGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="CARD" Binding="{Binding Card.Name}" Width="180" MinWidth="180" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="IN DECK" Binding="{Binding IncludedCopies}" Width="70" MinWidth="70" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="OWNED" Binding="{Binding OwnedCopies}" Width="70" MinWidth="70" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="LIMIT" Binding="{Binding LimitingReason}" Width="260" MinWidth="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="LOW VALUE">
                                        <DataGrid x:Name="ExcludedCardsGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="CARD" Binding="{Binding Card.Name}" Width="180" MinWidth="180" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="TIER" Binding="{Binding Tier}" Width="90" MinWidth="90" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="ROLE" Binding="{Binding Role}" Width="1.2*" MinWidth="160" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="WHY LEFT OUT" Binding="{Binding Rationale}" Width="260" MinWidth="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="STAR CHIPS">
                                        <DataGrid x:Name="PurchasePlanGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="CARD" Binding="{Binding Card}" Width="145" MinWidth="145" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="PASSWORD" Binding="{Binding Password}" Width="85" MinWidth="85" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="QTY" Binding="{Binding Copies}" Width="48" MinWidth="48" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="EACH" Binding="{Binding UnitCost}" Width="62" MinWidth="62" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="TOTAL" Binding="{Binding TotalCost}" Width="65" MinWidth="65" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="SPENT" Binding="{Binding CumulativeSpend}" Width="65" MinWidth="65" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="LEFT" Binding="{Binding Remaining}" Width="65" MinWidth="65" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="WHY THIS PURCHASE" Binding="{Binding Rationale}" Width="240" MinWidth="240" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="THREATS">
                                        <DataGrid x:Name="CampaignThreatsGrid" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2" Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="OPPONENT" Binding="{Binding Opponent}" Width="1.2*" MinWidth="160" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="THREAT" Binding="{Binding Threat}" Width="1.4*" MinWidth="160" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="ATK" Binding="{Binding Attack}" Width="65" MinWidth="65" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="STARS" Binding="{Binding GuardianStars}" Width="95" MinWidth="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource ResultCellText}" Header="SOURCE" Binding="{Binding Source}" Width="1.1*" MinWidth="160" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Grid>
</UserControl>
