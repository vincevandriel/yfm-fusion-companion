<UserControl x:Class="YfmCompanion.Desktop.Views.TurnAdviserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:YfmCompanion.Desktop.Controls">
<Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:AdaptiveColumnsPanel MinimumColumnWidth="240" MaximumColumns="3">
                            <GroupBox Header="HAND • ordered slots 1–5">
                                <StackPanel x:Name="HandPickerPanel" />
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="MONSTER FIELD • optional">
                                <StackPanel x:Name="MonsterPickerPanel" />
                            </GroupBox>
                            <GroupBox Grid.Column="2" Header="SPELL / TRAP FIELD • optional" Margin="0">
                                <StackPanel x:Name="SpellPickerPanel" />
                            </GroupBox>
                        </controls:AdaptiveColumnsPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="ANALYZE TURN" Click="AnalyzeTurn_Click" />
                            <Button Grid.Column="1" Content="CLEAR" Click="ClearTurn_Click" Background="#263E50" Foreground="{StaticResource TextBrush}" />
                            <CheckBox Grid.Column="2" x:Name="IncludeGlitchesCheckBox" Content="Include documented glitch fusions" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TurnResultSummary" Text="Enter any available cards; empty slots are ignored." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                            <DataGrid x:Name="TurnResultsGrid" Grid.Row="1" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12" MaxWidth="560" HorizontalAlignment="Left"><TextBlock Text="ORDERED INTERMEDIATE RESULTS" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Route}" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock Text="{Binding Field}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" /></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="2*" />
                                    <DataGridTextColumn Header="ATK" Binding="{Binding Attack}" Width="70" />
                                    <DataGridTextColumn Header="DEF" Binding="{Binding Defense}" Width="70" />
                                    <DataGridTextColumn Header="HAND ORDER" Binding="{Binding HandOrder}" Width="1.6*" />
                                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="4*" />
                                    <DataGridTextColumn Header="FIELD" Binding="{Binding Field}" Width="1.3*" />
                                    <DataGridCheckBoxColumn Header="GLITCH" Binding="{Binding IsGlitch}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
</UserControl>
