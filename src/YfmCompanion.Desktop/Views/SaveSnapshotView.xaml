<UserControl x:Class="YfmCompanion.Desktop.Views.SaveSnapshotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:YfmCompanion.Desktop.Controls">
<Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Header="SWANSTATION MEMORY CARD • READ ONLY" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.ColumnSpan="5">
                                    <Button x:Name="RefreshSaveButton" Content="REFRESH SAVED SNAPSHOT" Click="RefreshSaveSnapshot_Click" />
                                    <Button Content="CHOOSE SAVE FILE…" Click="SelectSave_Click" Background="#263E50" />
                                    <Button x:Name="ApplyDeckButton" Content="LOAD THIS DECK INTO ANALYZER" Click="ApplyDeckSnapshot_Click" IsEnabled="False" />
                                    <Button x:Name="ApplyOwnedButton" Content="LOAD OWNED CARDS INTO OPTIMIZER" Click="ApplyOwnedSnapshot_Click" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Text="Refresh reads the latest Forbidden Memories memory-card save. The load buttons copy that saved deck or collection into the named analysis screen; they never change the game save." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SaveSnapshotStatus" Grid.Row="2" Grid.ColumnSpan="5" Margin="0,6,0,0" Text="Looking for a saved memory-card snapshot…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                        </GroupBox>
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,12,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="SOURCE" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="SaveSourceText" Grid.Column="1" Text="Manual entry" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="SAVED" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                    <TextBlock x:Name="SaveTimestampText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </Grid>
                                <Expander Header="ADVANCED FILE AND VALIDATION DETAILS" Margin="0,8,0,0" IsExpanded="False">
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="FILE" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="SavePathText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="VALIDATION" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                        <TextBlock x:Name="SaveValidationText" Grid.Row="1" Grid.Column="1" Text="No saved snapshot loaded." TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <controls:AdaptiveColumnsPanel Grid.Row="2" MinimumColumnWidth="300" MaximumColumns="2">
                            <GroupBox Header="CONSTRUCTED DECK • 40 saved slots" Margin="0,0,12,0">
                                <ListBox x:Name="SaveDeckGrid" Style="{StaticResource CardPanelList}" />
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="COLLECTION • chest + constructed deck" Margin="0">
                                <ListBox x:Name="SaveCollectionGrid" Style="{StaticResource CardPanelList}" />
                            </GroupBox>
                        </controls:AdaptiveColumnsPanel>
                    </Grid>
</UserControl>
