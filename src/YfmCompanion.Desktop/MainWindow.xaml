<Window x:Class="YfmCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YfmCompanion.Desktop.Controls"
        xmlns:views="clr-namespace:YfmCompanion.Desktop.Views"
        Title="YFM Fusion Companion"
        Width="1420" Height="900" MinWidth="620" MinHeight="360"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootLayout" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AdaptiveColumnsPanel x:Name="AppHeader" MinimumColumnWidth="560" MaximumColumns="2" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="YFM FUSION COMPANION" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                <TextBlock x:Name="HeaderSubtitle" Text="Forbidden Memories • read-only live and saved snapshots" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <Border x:Name="SourceBadgeBorder" Background="#394B59" CornerRadius="4" Padding="10,5" Margin="0,0,12,0">
                    <TextBlock x:Name="SourceModeText" Text="MANUAL" Foreground="#70D8B2" FontWeight="SemiBold" />
                </Border>
                <Button x:Name="CompactModeButton" Content="COMPACT LIVE" Click="CompactMode_Click" Background="#263E50" Foreground="{StaticResource TextBrush}" Padding="12,7" />
                <Button x:Name="ExportDiagnosticsButton" Content="EXPORT DIAGNOSTICS" Click="ExportDiagnostics_Click" Background="#263E50" Foreground="{StaticResource TextBrush}" Padding="12,7" />
                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" Margin="6,0,0,0" />
            </WrapPanel>
        </controls:AdaptiveColumnsPanel>

        <Grid x:Name="FullWorkspace" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="FullWorkspaceScroll" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <TabControl x:Name="WorkspaceTabs" Margin="0" MinHeight="600" SelectionChanged="WorkspaceTabs_SelectionChanged">
                <TabItem Header="TURN ADVISER">
                    <views:TurnAdviserView x:Name="TurnAdviserPaneView" AnalyzeTurn_ClickRequested="AnalyzeTurn_Click"
                        ClearTurn_ClickRequested="ClearTurn_Click" />
                </TabItem>

                <TabItem x:Name="DeckAnalyzerTab" Header="DECK ANALYZER">
                    <views:DeckAnalyzerView x:Name="DeckAnalyzerPaneView" AddDeckCardRequested="AddDeckCard_Click" RemoveDeckCardRequested="RemoveDeckCard_Click" AnalyzeDeck_ClickRequested="AnalyzeDeck_Click"
                        LoadCurrentDeckFromSave_ClickRequested="LoadCurrentDeckFromSave_Click"
                        CancelDeck_ClickRequested="CancelDeck_Click"
                        ClearDeck_ClickRequested="ClearDeck_Click" />
                </TabItem>

                <TabItem x:Name="LiveDuelTab" Header="LIVE DUEL">
                    <views:LiveDuelView x:Name="LiveDuelPaneView" ToggleInspector_ClickRequested="ToggleInspector_Click"
                        LiveCard_SelectionChangedRequested="LiveCard_SelectionChanged" />
                </TabItem>

                <TabItem x:Name="OwnedOptimizerTab" Header="OWNED-CARD OPTIMIZER">
                    <views:OwnedOptimizerView x:Name="OwnedOptimizerPaneView" RefreshSaveSnapshot_ClickRequested="RefreshSaveSnapshot_Click"
                        SelectSave_ClickRequested="SelectSave_Click"
                        UseAutomaticSave_ClickRequested="UseAutomaticSave_Click"
                        UseManualCollection_ClickRequested="UseManualCollection_Click"
                        CampaignScope_SelectionChangedRequested="CampaignScope_SelectionChanged"
                        CampaignStarChipSetting_ChangedRequested="CampaignStarChipSetting_Changed"
                        OptimizerProfile_SelectionChangedRequested="OptimizerProfile_SelectionChanged"
                        OptimizeDeck_ClickRequested="OptimizeDeck_Click"
                        PauseOptimization_ClickRequested="PauseOptimization_Click"
                        StopOptimization_ClickRequested="StopOptimization_Click"
                        VerifyOptimization_ClickRequested="VerifyOptimization_Click"
                        ClearOwned_ClickRequested="ClearOwned_Click"
                        OptimizerBody_SizeChangedRequested="OptimizerBody_SizeChanged"
                        OwnedSearch_TextChangedRequested="OwnedSearch_TextChanged"
                        OwnedFilter_ChangedRequested="OwnedFilter_Changed"
                        AddOwnedCard_ClickRequested="AddOwnedCard_Click"
                        ChooseArtworkFolder_ClickRequested="ChooseArtworkFolder_Click"
                        AssignSelectedArtwork_ClickRequested="AssignSelectedArtwork_Click"
                        OwnedCards_SelectionChangedRequested="OwnedCards_SelectionChanged" />
                </TabItem>
            </TabControl>
            </ScrollViewer>

            <Border x:Name="OptimizerActivityDock" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right">
                            <Button x:Name="DockPauseButton" Content="PAUSE" Click="PauseOptimization_Click" IsEnabled="{Binding CanPause}" Padding="8,3" FontSize="11" />
                            <Button x:Name="DockResumeButton" Content="RESUME" Click="OptimizeDeck_Click" IsEnabled="{Binding CanResume}" Padding="8,3" FontSize="11" />
                            <Button x:Name="DockStopButton" Content="STOP • KEEP BEST" Click="StopOptimization_Click" Padding="8,3" FontSize="11" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Stage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Stage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar x:Name="DockProgressBar" Minimum="0" Maximum="1" Value="{Binding Value}" IsIndeterminate="{Binding IsIndeterminate}" Height="7" Margin="0,3" />
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border x:Name="InspectorPanel" Grid.Column="0" Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="20"
                    Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InspectorTranslate" X="360" />
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CARD INSPECTOR" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="CLOSE" Click="CloseInspector_Click" Background="#263E50" Foreground="{StaticResource TextBrush}" Padding="10,6" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="InspectorPrompt" Text="Select a card in the Live Duel tables to inspect its data." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                        <StackPanel x:Name="InspectorContent" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="InspectorName" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="InspectorId" Foreground="{StaticResource GoldBrush}" Margin="0,3,0,14" />
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TYPE" Padding="10" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="InspectorType" Grid.Column="1" Padding="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="ATK" Padding="10" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="InspectorAttack" Grid.Row="1" Grid.Column="1" Padding="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="DEF" Padding="10" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="InspectorDefense" Grid.Row="2" Grid.Column="1" Padding="10" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Expander Header="ADVANCED DATA" Margin="0,18,0,0" Foreground="{StaticResource AccentBrush}">
                                <TextBlock x:Name="InspectorAdvanced" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="22" Margin="0,12,0,0" />
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="CompactWorkspace" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="BEST LEGAL ROUTES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <CheckBox x:Name="CompactTopmostCheckBox" Grid.Column="1" Content="PIN" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" Margin="4,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="FULL" Click="CompactMode_Click" Background="#263E50" Foreground="{StaticResource TextBrush}" Padding="8,4" Margin="4,0,0,0" />
            </Grid>
            <DataGrid x:Name="CompactAdviceGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" FontSize="12" RowHeaderWidth="0" HeadersVisibility="Column" RowHeight="72" ColumnHeaderHeight="32" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="RESULT" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,1">
                                    <TextBlock Text="{Binding Result}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Result}" />
                                    <TextBlock Text="{Binding GuardianStar1}" FontSize="20" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GuardianOutcomes1}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="2,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GuardianVisual1}" Value="Warm"><Setter Property="Background" Value="#665026" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding GuardianVisual1}" Value="Threat"><Setter Property="Background" Value="#702B35" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding GuardianStar2}" FontSize="20" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GuardianOutcomes2}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="2,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GuardianVisual2}" Value="Warm"><Setter Property="Background" Value="#665026" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding GuardianVisual2}" Value="Threat"><Setter Property="Background" Value="#702B35" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ATK" Binding="{Binding Attack}" Width="49" />
                    <DataGridTemplateColumn Header="ROUTE" Width="77">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Route}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Route}" Padding="3,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="DatabaseStatus" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,0" />
    </Grid>
</Window>
